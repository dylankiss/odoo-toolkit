{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Odoo: run and debug",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "preLaunchTask": "otk: run Odoo with the debugger",
            "postDebugTask": "otk: stop Odoo",
            "justMyCode": false,
            "redirectOutput": false
        },
        {
            "name": "Odoo: attach to the debugger",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "justMyCode": false,
            "redirectOutput": false
        }
    ]
}
