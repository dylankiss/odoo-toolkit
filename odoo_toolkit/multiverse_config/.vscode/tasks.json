{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "otk: run Odoo with the debugger",
            "detail": "Uses a database named after the version, like 19.0. Add Odoo options after it, like \"-i\", \"sale\".",
            "type": "shell",
            "command": "otk",
            "args": ["dev", "run", "--debug", "--", "-d", "${workspaceFolderBasename}"],
            "isBackground": true,
            "problemMatcher": {
                "owner": "otk",
                "pattern": {
                    "regexp": "^__otk_never_matches__$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^otk: starting Odoo",
                    "endsPattern": "^otk: waiting for the debugger"
                }
            }
        },
        {
            "label": "otk: run Odoo",
            "type": "shell",
            "command": "otk",
            "args": ["dev", "run", "--", "-d", "${workspaceFolderBasename}"],
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "otk: stop Odoo",
            "type": "shell",
            "command": "otk",
            "args": ["dev", "stop", "--port", "8069"],
            "presentation": {
                "reveal": "silent"
            },
            "problemMatcher": []
        }
    ]
}
