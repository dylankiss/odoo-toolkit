{
    "remoteUser": "odoo",
    "updateRemoteUserUID": true,
    "containerEnv": {
        "GIT_CONFIG_COUNT": "2",
        "GIT_CONFIG_KEY_0": "core.checkStat",
        "GIT_CONFIG_VALUE_0": "minimal",
        "GIT_CONFIG_KEY_1": "core.trustctime",
        "GIT_CONFIG_VALUE_1": "false"
    },
    "remoteEnv": {
        "PATH": "/venv/main/bin:${containerEnv:PATH}",
        "SSH_AUTH_SOCK": null,
        "GIT_CONFIG_NOSYSTEM": "1"
    },
    "onCreateCommand": "mkdir -p .venv/bin && for name in python python3 activate; do ln -sf /venv/main/bin/$name .venv/bin/$name; done",
    "postStartCommand": "git config --global --unset-all credential.helper || true",
    "postAttachCommand": "rm -f /tmp/vscode-ssh-auth-*.sock",
    "otherPortsAttributes": {
        "onAutoForward": "ignore"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "anthropic.claude-code",
                "charliermarsh.ruff",
                "dbaeumer.vscode-eslint",
                "eamodio.gitlens",
                "kevinrose.vsc-python-indent",
                "ms-python.debugpy",
                "ms-python.python",
                "njpwerner.autodocstring",
                "odoo.odoo",
                "odoo.owl-vision",
                "redhat.vscode-xml"
            ],
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash",
                "remote.autoForwardPorts": false,
                "git.terminalAuthentication": false,
                "github.gitAuthentication": false,
                "git.enableCommitSigning": false,
                "git.repositoryScanMaxDepth": 1,
                "python-envs.terminal.autoActivationType": "command",
                "launch": {
                    "version": "0.2.0",
                    "configurations": [
                        {
                            "name": "Odoo (container): run and debug",
                            "type": "debugpy",
                            "request": "launch",
                            "justMyCode": false,
                            "console": "integratedTerminal"
                        }
                    ]
                }
            }
        }
    }
}
