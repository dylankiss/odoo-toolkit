{
    "name": "odoo-toolkit",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "remoteUser": "vscode",
    "updateRemoteUserUID": true,
    "runArgs": ["--name=odoo-toolkit-dev", "--cap-drop=ALL", "--security-opt=no-new-privileges", "--init"],
    "mounts": [
        "source=odoo-toolkit-claude,target=/home/vscode/.claude,type=volume",
        "source=${localWorkspaceFolder}/.devcontainer,target=${containerWorkspaceFolder}/.devcontainer,type=bind,readonly",
        "source=${localWorkspaceFolder}/.vscode,target=${containerWorkspaceFolder}/.vscode,type=bind,readonly",
        "source=${localWorkspaceFolder}/.git/hooks,target=${containerWorkspaceFolder}/.git/hooks,type=bind,readonly"
    ],
    "containerEnv": {
        "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
        "UV_PROJECT_ENVIRONMENT": "/home/vscode/.venv",
        "UV_LINK_MODE": "copy"
    },
    "remoteEnv": {
        "PATH": "/home/vscode/.venv/bin:/home/vscode/.local/bin:${containerEnv:PATH}",
        "SSH_AUTH_SOCK": null
    },
    "onCreateCommand": "pip install --user --quiet uv && uv sync --quiet",
    "postStartCommand": "git config --global --unset-all credential.helper || true",
    "postAttachCommand": "rm -f /tmp/vscode-ssh-auth-*.sock",
    "otherPortsAttributes": {
        "onAutoForward": "ignore"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "anthropic.claude-code",
                "charliermarsh.ruff",
                "ms-python.python",
                "ms-python.debugpy",
                "njpwerner.autodocstring"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/home/vscode/.venv/bin/python",
                "remote.autoForwardPorts": false,
                "git.terminalAuthentication": false,
                "github.gitAuthentication": false,
                "git.enableCommitSigning": false
            }
        }
    }
}
